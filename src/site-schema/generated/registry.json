{
  "sections": [
    {
      "version": 1,
      "id": "cta.banner",
      "type": "cta",
      "variant": "banner",
      "contract": "./contract.schema.json",
      "definition": "./definition.tsx",
      "capability": {
        "title": "Order banner",
        "description": "Original template order-ahead banner with one main action and service badges.",
        "useWhen": [
          "Promote pickup, delivery or catering with one main call to action"
        ],
        "avoidWhen": [
          "The page needs a list of independent story links"
        ],
        "rendering": "server"
      },
      "schemaKey": "CtaBannerSection",
      "contentFields": [
        {
          "name": "eyebrow",
          "required": true,
          "type": "string"
        },
        {
          "name": "title",
          "required": true,
          "type": "string"
        },
        {
          "name": "description",
          "required": true,
          "type": "string"
        },
        {
          "name": "action",
          "required": true
        },
        {
          "name": "perks",
          "required": true,
          "type": "array"
        },
        {
          "name": "monogram",
          "required": true,
          "type": "string"
        }
      ]
    },
    {
      "version": 1,
      "id": "features.icon-grid",
      "type": "features",
      "variant": "icon-grid",
      "contract": "./contract.schema.json",
      "definition": "./definition.tsx",
      "capability": {
        "title": "Feature icon grid",
        "description": "Displays concise feature items with icon media.",
        "useWhen": [
          "Summarize services or benefits in a grid"
        ],
        "avoidWhen": [
          "Show long editorial stories"
        ],
        "rendering": "server"
      },
      "schemaKey": "FeaturesIconGridSection",
      "contentFields": [
        {
          "name": "items",
          "required": true,
          "type": "array"
        }
      ]
    },
    {
      "version": 1,
      "id": "hero.default",
      "type": "hero",
      "variant": "default",
      "contract": "./contract.schema.json",
      "definition": "./definition.tsx",
      "capability": {
        "title": "Default hero",
        "description": "A media-led hero with title, description and up to three actions.",
        "useWhen": [
          "The page needs a primary opening message",
          "The hero has one or more images"
        ],
        "avoidWhen": [
          "The page only needs an editorial introduction"
        ],
        "rendering": "server"
      },
      "schemaKey": "HeroDefaultSection",
      "contentFields": [
        {
          "name": "eyebrow",
          "required": true,
          "type": "string"
        },
        {
          "name": "title",
          "required": true,
          "type": "string"
        },
        {
          "name": "description",
          "required": true,
          "type": "string"
        },
        {
          "name": "primaryAction",
          "required": true
        },
        {
          "name": "secondaryAction",
          "required": true
        },
        {
          "name": "benefits",
          "required": true,
          "type": "array"
        },
        {
          "name": "media",
          "required": true,
          "type": "array"
        },
        {
          "name": "carousel",
          "required": true,
          "type": "object"
        }
      ]
    },
    {
      "version": 1,
      "id": "locations.map-list",
      "type": "locations",
      "variant": "map-list",
      "contract": "./contract.schema.json",
      "definition": "./definition.tsx",
      "capability": {
        "title": "Location map list",
        "description": "Shows one or more restaurant locations with address, hours and directions.",
        "useWhen": [
          "Present location details on a landing page"
        ],
        "avoidWhen": [
          "Feature only one location with a storefront image"
        ],
        "rendering": "server"
      },
      "schemaKey": "LocationsMapListSection",
      "contentFields": [
        {
          "name": "eyebrow",
          "required": true,
          "type": "string"
        },
        {
          "name": "title",
          "required": true,
          "type": "string"
        },
        {
          "name": "description",
          "required": true,
          "type": "string"
        },
        {
          "name": "locations",
          "required": true,
          "type": "array"
        },
        {
          "name": "directionsLabel",
          "required": true,
          "type": "string"
        },
        {
          "name": "action",
          "required": true
        }
      ]
    },
    {
      "version": 1,
      "id": "menu.catalog",
      "type": "menu",
      "variant": "catalog",
      "contract": "./contract.schema.json",
      "definition": "./definition.tsx",
      "capability": {
        "title": "Menu catalog",
        "description": "Renders v45 menu categories and products with filtering, sorting and order state.",
        "useWhen": [
          "Build the canonical /menu page"
        ],
        "avoidWhen": [
          "Show a small featured product rail"
        ],
        "rendering": "client-island"
      },
      "schemaKey": "MenuCatalogSection",
      "contentFields": [
        {
          "name": "hero",
          "required": true,
          "type": "object"
        },
        {
          "name": "categories",
          "required": true,
          "type": "array"
        },
        {
          "name": "limitedDescription",
          "required": true,
          "type": "string"
        },
        {
          "name": "currency",
          "required": true
        }
      ]
    },
    {
      "version": 1,
      "id": "products.carousel",
      "type": "products",
      "variant": "carousel",
      "contract": "./contract.schema.json",
      "definition": "./definition.tsx",
      "capability": {
        "title": "Product carousel",
        "description": "Displays a curated set of products from a v45 Section content.products array.",
        "useWhen": [
          "Highlight featured menu items on a content page"
        ],
        "avoidWhen": [
          "Render the complete menu catalog with category filters"
        ],
        "rendering": "server"
      },
      "schemaKey": "ProductsCarouselSection",
      "contentFields": [
        {
          "name": "eyebrow",
          "required": true,
          "type": "string"
        },
        {
          "name": "title",
          "required": true,
          "type": "string"
        },
        {
          "name": "description",
          "required": true,
          "type": "string"
        },
        {
          "name": "action",
          "required": true
        },
        {
          "name": "productActionLabel",
          "required": true,
          "type": "string"
        },
        {
          "name": "products",
          "required": true,
          "type": "array"
        }
      ]
    },
    {
      "version": 1,
      "id": "reviews.carousel",
      "type": "reviews",
      "variant": "carousel",
      "contract": "./contract.schema.json",
      "definition": "./definition.tsx",
      "capability": {
        "title": "Review carousel",
        "description": "Shows guest reviews with a small client island for carousel navigation.",
        "useWhen": [
          "Add social proof from v45 content.reviews"
        ],
        "avoidWhen": [
          "Display a static FAQ or feature list"
        ],
        "rendering": "client-island"
      },
      "schemaKey": "ReviewsCarouselSection",
      "contentFields": [
        {
          "name": "eyebrow",
          "required": true,
          "type": "string"
        },
        {
          "name": "title",
          "required": true,
          "type": "string"
        },
        {
          "name": "reviews",
          "required": true,
          "type": "array"
        }
      ]
    },
    {
      "version": 1,
      "id": "story.split",
      "type": "story",
      "variant": "split",
      "contract": "./contract.schema.json",
      "definition": "./definition.tsx",
      "capability": {
        "title": "Split story",
        "description": "Two-column editorial story with media and an optional page action.",
        "useWhen": [
          "A page needs a story beside one image"
        ],
        "avoidWhen": [
          "The story requires a sequence of multiple items"
        ],
        "rendering": "server"
      },
      "schemaKey": "StorySplitSection",
      "contentFields": [
        {
          "name": "eyebrow",
          "required": true,
          "type": "string"
        },
        {
          "name": "title",
          "required": true,
          "type": "string"
        },
        {
          "name": "description",
          "required": true,
          "type": "string"
        },
        {
          "name": "media",
          "required": true
        },
        {
          "name": "ingredientsLabel",
          "required": true,
          "type": "string"
        },
        {
          "name": "ingredients",
          "required": true,
          "type": "array"
        },
        {
          "name": "promises",
          "required": true,
          "type": "array"
        },
        {
          "name": "action",
          "required": true
        }
      ]
    }
