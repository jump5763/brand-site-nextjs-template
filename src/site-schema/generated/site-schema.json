{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codeforma.local/site-schema/generated",
  "title": "SiteDocument",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "siteId",
    "siteUrl",
    "theme",
    "pages"
  ],
  "properties": {
    "siteId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"
    },
    "siteUrl": {
      "type": "string",
      "pattern": "^https?://[^\\s]+$",
      "format": "uri"
    },
    "theme": {
      "$ref": "#/$defs/theme"
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/page"
      }
    }
  },
  "$defs": {
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fonts",
        "colors"
      ],
      "properties": {
        "fonts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "heading",
            "typography"
          ],
          "properties": {
            "heading": {
              "enum": [
                "System Sans",
                "System Serif"
              ]
            },
            "typography": {
              "enum": [
                "System Sans",
                "System Serif"
              ]
            }
          }
        },
        "colors": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "background",
            "foreground",
            "card",
            "cardForeground",
            "popover",
            "popoverForeground",
            "primary",
            "primaryForeground",
            "secondary",
            "secondaryForeground",
            "muted",
            "mutedForeground",
            "accent",
            "accentForeground",
            "destructive",
            "destructiveForeground",
            "border",
            "input",
            "ring"
          ],
          "properties": {
            "background": {
              "$ref": "#/$defs/color"
            },
            "foreground": {
              "$ref": "#/$defs/color"
            },
            "card": {
              "$ref": "#/$defs/color"
            },
            "cardForeground": {
              "$ref": "#/$defs/color"
            },
            "popover": {
              "$ref": "#/$defs/color"
            },
            "popoverForeground": {
              "$ref": "#/$defs/color"
            },
            "primary": {
              "$ref": "#/$defs/color"
            },
            "primaryForeground": {
              "$ref": "#/$defs/color"
            },
            "secondary": {
              "$ref": "#/$defs/color"
            },
            "secondaryForeground": {
              "$ref": "#/$defs/color"
            },
            "muted": {
              "$ref": "#/$defs/color"
            },
            "mutedForeground": {
              "$ref": "#/$defs/color"
            },
            "accent": {
              "$ref": "#/$defs/color"
            },
            "accentForeground": {
              "$ref": "#/$defs/color"
            },
            "destructive": {
              "$ref": "#/$defs/color"
            },
            "destructiveForeground": {
              "$ref": "#/$defs/color"
            },
            "border": {
              "$ref": "#/$defs/color"
            },
            "input": {
              "$ref": "#/$defs/color"
            },
            "ring": {
              "$ref": "#/$defs/color"
            }
          }
        }
      }
    },
    "color": {
      "type": "string",
      "pattern": "^(#[0-9A-Fa-f]{6}|hsl\\([0-9.]+ [0-9.]+% [0-9.]+%\\))$"
    },
    "page": {
      "title": "SitePage",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "metadata",
        "sections"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "pattern": "^/"
        },
        "metadata": {
          "$ref": "#/$defs/metadata"
        },
        "sections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/section"
          }
        }
      }
    },
    "section": {
      "title": "SiteSection",
      "oneOf": [
        {
          "$ref": "#/$defs/FeaturedDishesCarouselSection"
        },
        {
          "$ref": "#/$defs/IngredientsDefaultSection"
        },
        {
          "$ref": "#/$defs/LocationsDefaultSection"
        },
        {
          "$ref": "#/$defs/MarqueeDefaultSection"
        },
        {
          "$ref": "#/$defs/MenuCatalogDefaultSection"
        },
        {
          "$ref": "#/$defs/PageHeroBannerSection"
        },
        {
          "$ref": "#/$defs/PageHeroOverlaySection"
        },
        {
          "$ref": "#/$defs/SiteFooterDefaultSection"
        },
        {
          "$ref": "#/$defs/SiteHeaderDefaultSection"
        },
        {
          "$ref": "#/$defs/StorySplitSection"
        },
        {
          "$ref": "#/$defs/TestimonialsGridSection"
        }
      ]
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonicalPath",
        "title",
        "description"
      ],
      "properties": {
        "canonicalPath": {
          "type": "string",
          "pattern": "^/"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "robots": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "index",
            "follow"
          ],
          "properties": {
            "index": {
              "type": "boolean"
            },
            "follow": {
              "type": "boolean"
            }
          }
        },
        "openGraph": {
          "type": "object"
        },
        "structuredData": {
          "type": [
            "object",
            "array"
          ]
        }
      }
    },
    "media": {
      "title": "SiteMedia",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "path",
        "alt"
      ],
      "properties": {
        "kind": {
          "const": "image"
        },
        "path": {
          "type": "string",
          "pattern": "^(\\/media\\/|https:\\/\\/)"
        },
        "alt": {
          "type": "string"
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "linkTarget": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "pageId"
          ],
          "properties": {
            "kind": {
              "const": "page"
            },
            "pageId": {
              "type": "string",
              "minLength": 1
            },
            "fragment": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "href"
          ],
          "properties": {
            "kind": {
              "const": "external"
            },
            "href": {
              "type": "string",
              "pattern": "^https?://"
            }
          }
        }
      ]
    },
    "siteAction": {
      "title": "SiteAction",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "target"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "$ref": "#/$defs/linkTarget"
        }
      }
    },
    "FeaturedDishesCarouselSection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "variant",
        "content"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "const": "featured-dishes"
        },
        "variant": {
          "const": "carousel"
        },
        "content": {
          "title": "Featured Dishes Carousel",
          "type": "object",
          "required": [
            "title",
            "items"
          ],
          "additionalProperties": false,
          "properties": {
            "eyebrow": {
              "type": "string",
              "minLength": 1,
              "description": "Small uppercase kicker above the section heading."
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "description": "Section h2."
            },
            "description": {
              "type": "string",
              "minLength": 1,
              "description": "Short introduction under the section heading."
            },
            "items": {
              "type": "array",
              "minItems": 3,
              "maxItems": 8,
              "items": {
                "$ref": "#/$defs/FeaturedDishesCarouselSection/properties/content/$defs/dish"
              }
            },
            "action": {
              "$ref": "#/$defs/siteAction",
              "description": "Optional link to the complete menu."
            }
          },
          "$defs": {
            "dish": {
              "type": "object",
              "required": [
                "name",
                "description",
                "price",
                "media"
              ],
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Card h3."
                },
                "description": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Short dish description."
                },
                "price": {
                  "type": "string",
                  "pattern": "^\\$[0-9]+\\.[0-9]{2}$",
                  "description": "Display price such as $12.75."
                },
                "badge": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Optional short label such as New or Seasonal."
                },
                "media": {
                  "$ref": "#/$defs/media"
                },
                "action": {
                  "$ref": "#/$defs/siteAction"
                }
              }
            }
          }
        }
      },
      "title": "FeaturedDishesCarouselSection"
    },
    "IngredientsDefaultSection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "variant",
        "content"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "const": "ingredients"
        },
        "variant": {
          "const": "default"
        },
        "content": {
          "title": "Ingredients Feature",
          "type": "object",
          "required": [
            "title",
            "items",
            "media"
          ],
          "additionalProperties": false,
          "properties": {
            "eyebrow": {
              "type": "string",
              "minLength": 1,
              "description": "Small uppercase kicker above the heading."
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "description": "Section h2."
            },
            "description": {
              "type": "string",
              "minLength": 1,
              "description": "Introductory paragraph beside the heading."
            },
            "note": {
              "type": "string",
              "minLength": 1,
              "description": "Optional short closing line, such as a sourcing promise."
            },
            "media": {
              "$ref": "#/$defs/media",
              "description": "Main photograph."
            },
            "mediaSecondary": {
              "$ref": "#/$defs/media",
              "description": "Optional smaller inset photograph."
            },
            "items": {
              "type": "array",
              "minItems": 2,
              "maxItems": 4,
              "items": {
                "type": "object",
                "required": [
                  "name",
                  "description",
                  "icon"
                ],
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Highlight h3."
                  },
                  "description": {
                    "type": "string",
                    "minLength": 1,
                    "description": "One or two sentences about this ingredient."
                  },
                  "icon": {
                    "enum": [
                      "leaf",
                      "sprout",
                      "droplet",
                      "wheat",
                      "sun",
                      "flame",
                      "heart",
                      "truck"
                    ],
                    "description": "Icon key rendered by the view."
                  }
                }
              }
            }
          }
        }
      },
      "title": "IngredientsDefaultSection"
    },
    "LocationsDefaultSection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "variant",
        "content"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "const": "locations"
        },
        "variant": {
          "const": "default"
        },
        "content": {
          "title": "Store Locations",
          "type": "object",
          "required": [
            "title",
            "stores"
          ],
          "additionalProperties": false,
          "properties": {
            "eyebrow": {
              "type": "string",
              "minLength": 1,
              "description": "Small uppercase kicker above the heading."
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "description": "Section h2."
            },
            "description": {
              "type": "string",
              "minLength": 1,
              "description": "Short introduction under the heading."
            },
            "mapNote": {
              "type": "string",
              "minLength": 1,
              "description": "Optional line under the map, for example parking or delivery information."
            },
            "stores": {
              "type": "array",
              "minItems": 1,
              "maxItems": 3,
              "items": {
                "type": "object",
                "required": [
                  "name",
                  "address",
                  "mapQuery",
                  "hours"
                ],
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Store card h3."
                  },
                  "address": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Single line street address."
                  },
                  "phone": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Store phone number as display text."
                  },
                  "hours": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 3,
                    "items": {
                      "type": "object",
                      "required": [
                        "label",
                        "value"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "label": {
                          "type": "string",
                          "minLength": 1
                        },
                        "value": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    }
                  },
                  "mapQuery": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Place query passed to the Google map embed."
                  },
                  "mapZoom": {
                    "type": "integer",
                    "minimum": 10,
                    "maximum": 19,
                    "description": "Optional map zoom level."
                  },
                  "directions": {
                    "$ref": "#/$defs/siteAction",
                    "description": "Optional external directions link."
                  }
                }
              }
            }
          }
        }
      },
      "title": "LocationsDefaultSection"
    },
    "MarqueeDefaultSection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "variant",
        "content"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "const": "marquee"
        },
        "variant": {
          "const": "default"
        },
        "content": {
          "title": "Marquee Band",
          "type": "object",
          "required": [
            "items"
          ],
          "additionalProperties": false,
          "properties": {
            "items": {
              "type": "array",
              "minItems": 2,
              "maxItems": 8,
              "items": {
                "type": "string",
                "minLength": 1,
                "description": "Short uppercase statement, ideally under 32 characters."
              }
            }
          }
        }
      },
      "title": "MarqueeDefaultSection"
    },
    "MenuCatalogDefaultSection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "variant",
        "content"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "const": "menu-catalog"
        },
        "variant": {
          "const": "default"
        },
        "content": {
          "title": "Menu Catalog",
          "type": "object",
          "required": [
            "title",
            "categories",
            "items"
          ],
          "additionalProperties": false,
          "properties": {
            "eyebrow": {
              "type": "string",
              "minLength": 1,
              "description": "Small uppercase kicker above the section heading."
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "description": "Stable section h2 above the category tabs."
            },
            "description": {
              "type": "string",
              "minLength": 1,
              "description": "Short introduction under the section heading."
            },
            "categories": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "items": {
                "type": "object",
                "required": [
                  "name"
                ],
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Tab label; every dish category must equal one of these names."
                  },
                  "description": {
                    "type": "string",
                    "minLength": 1,
                    "description": "One line describing the category."
                  }
                }
              }
            },
            "items": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "name",
                  "description",
                  "price",
                  "category",
                  "media"
                ],
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Card h4."
                  },
                  "description": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Short dish description."
                  },
                  "price": {
                    "type": "string",
                    "pattern": "^\\$[0-9]+\\.[0-9]{2}$",
                    "description": "Display price such as $12.75."
                  },
                  "category": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Must equal one of the declared category names."
                  },
                  "tags": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 3,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "description": "Dietary labels such as Vegan, Gluten-Free, High Protein, Spicy."
                  },
                  "metadata": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Short factual detail such as 420 cal or Serves 2."
                  },
                  "badge": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Optional short label such as New, Chef's pick or Limited."
                  },
                  "media": {
                    "$ref": "#/$defs/media"
                  }
                }
              }
            }
          }
        }
      },
      "title": "MenuCatalogDefaultSection"
    },
    "PageHeroBannerSection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "variant",
        "content"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "const": "page-hero"
        },
        "variant": {
          "const": "banner"
        },
        "content": {
          "title": "Page Banner",
          "type": "object",
          "required": [
            "title",
            "media"
          ],
          "additionalProperties": false,
          "properties": {
            "eyebrow": {
              "type": "string",
              "minLength": 1,
              "description": "Small uppercase kicker above the title."
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "description": "The page h1. One per page."
            },
            "description": {
              "type": "string",
              "minLength": 1,
              "description": "Short introduction paragraph."
            },
            "media": {
              "$ref": "#/$defs/media",
              "description": "Photograph displayed beside the introduction."
            },
            "meta": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4,
              "items": {
                "type": "string",
                "minLength": 1
              },
              "description": "Short pills summarising the page content."
            }
          }
        }
      },
      "title": "PageHeroBannerSection"
    },
    "PageHeroOverlaySection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "variant",
        "content"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "const": "page-hero"
        },
        "variant": {
          "const": "overlay"
        },
        "content": {
          "title": "Full-Screen Hero",
          "type": "object",
          "required": [
            "headline",
            "media",
            "primaryAction"
          ],
          "additionalProperties": false,
          "properties": {
            "eyebrow": {
              "type": "string",
              "minLength": 1,
              "description": "Small uppercase kicker above the headline."
            },
            "headline": {
              "type": "string",
              "minLength": 1,
              "description": "The page h1. One per page."
            },
            "subheadline": {
              "type": "string",
              "minLength": 1,
              "description": "Supporting sentence under the headline."
            },
            "media": {
              "$ref": "#/$defs/media",
              "description": "Full-bleed background photograph."
            },
            "primaryAction": {
              "$ref": "#/$defs/siteAction"
            },
            "secondaryAction": {
              "$ref": "#/$defs/siteAction"
            },
            "highlights": {
              "type": "array",
              "minItems": 2,
              "maxItems": 4,
              "items": {
                "$ref": "#/$defs/PageHeroOverlaySection/properties/content/$defs/highlight"
              }
            }
          },
          "$defs": {
            "highlight": {
              "type": "object",
              "required": [
                "value",
                "label"
              ],
              "additionalProperties": false,
              "properties": {
                "value": {
                  "type": "string",
                  "minLength": 1
                },
                "label": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      },
      "title": "PageHeroOverlaySection"
    },
    "SiteFooterDefaultSection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "variant",
        "content"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "const": "site-footer"
        },
        "variant": {
          "const": "default"
        },
        "content": {
          "title": "Site Footer",
          "type": "object",
          "required": [
            "brandName",
            "tagline",
            "explore",
            "hours",
            "visit",
            "legalNote"
          ],
          "additionalProperties": false,
          "properties": {
            "brandName": {
              "type": "string",
              "minLength": 1
            },
            "tagline": {
              "type": "string",
              "minLength": 1
            },
            "social": {
              "type": "array",
              "minItems": 1,
              "maxItems": 3,
              "items": {
                "$ref": "#/$defs/SiteFooterDefaultSection/properties/content/$defs/socialLink"
              }
            },
            "explore": {
              "$ref": "#/$defs/SiteFooterDefaultSection/properties/content/$defs/linkColumn"
            },
            "hours": {
              "$ref": "#/$defs/SiteFooterDefaultSection/properties/content/$defs/hoursColumn"
            },
            "visit": {
              "$ref": "#/$defs/SiteFooterDefaultSection/properties/content/$defs/visitColumn"
            },
            "backToTop": {
              "$ref": "#/$defs/siteAction"
            },
            "legalNote": {
              "type": "string",
              "minLength": 1
            }
          },
          "$defs": {
            "socialLink": {
              "type": "object",
              "required": [
                "label",
                "icon",
                "target"
              ],
              "additionalProperties": false,
              "properties": {
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Accessible name of the icon-only link."
                },
                "icon": {
                  "enum": [
                    "instagram",
                    "facebook",
                    "youtube"
                  ]
                },
                "target": {
                  "$ref": "#/$defs/linkTarget"
                }
              }
            },
            "linkColumn": {
              "type": "object",
              "required": [
                "title",
                "links"
              ],
              "additionalProperties": false,
              "properties": {
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "links": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "$ref": "#/$defs/SiteFooterDefaultSection/properties/content/$defs/labeledTarget"
                  }
                }
              }
            },
            "labeledTarget": {
              "type": "object",
              "required": [
                "label",
                "target"
              ],
              "additionalProperties": false,
              "properties": {
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "target": {
                  "$ref": "#/$defs/linkTarget"
                }
              }
            },
            "hoursColumn": {
              "type": "object",
              "required": [
                "title",
                "entries"
              ],
              "additionalProperties": false,
              "properties": {
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "entries": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "$ref": "#/$defs/SiteFooterDefaultSection/properties/content/$defs/labelValue"
                  }
                }
              }
            },
            "labelValue": {
              "type": "object",
              "required": [
                "label",
                "value"
              ],
              "additionalProperties": false,
              "properties": {
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "value": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "visitColumn": {
              "type": "object",
              "required": [
                "title",
                "stores",
                "email"
              ],
              "additionalProperties": false,
              "properties": {
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "email": {
                  "type": "string",
                  "minLength": 1
                },
                "stores": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "$ref": "#/$defs/SiteFooterDefaultSection/properties/content/$defs/store"
                  }
                }
              }
            },
            "store": {
              "type": "object",
              "required": [
                "name",
                "address"
              ],
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "address": {
                  "type": "string",
                  "minLength": 1
                },
                "phone": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      },
      "title": "SiteFooterDefaultSection"
    },
    "SiteHeaderDefaultSection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "variant",
        "content"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "const": "site-header"
        },
        "variant": {
          "const": "default"
        },
        "content": {
          "title": "Site Header",
          "type": "object",
          "required": [
            "brandName",
            "navigation",
            "action"
          ],
          "additionalProperties": false,
          "properties": {
            "brandName": {
              "type": "string",
              "minLength": 1,
              "description": "Wordmark shown at the start of the bar."
            },
            "brandTagline": {
              "type": "string",
              "minLength": 1,
              "description": "Short line rendered under the wordmark on wider viewports."
            },
            "brandTarget": {
              "$ref": "#/$defs/linkTarget",
              "description": "Destination of the wordmark link. Defaults to the site root."
            },
            "navigation": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/SiteHeaderDefaultSection/properties/content/$defs/navigationItem"
              }
            },
            "action": {
              "$ref": "#/$defs/siteAction",
              "description": "Primary call to action rendered as the brand button."
            }
          },
          "$defs": {
            "navigationItem": {
              "type": "object",
              "required": [
                "label",
                "target"
              ],
              "additionalProperties": false,
              "properties": {
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "target": {
                  "$ref": "#/$defs/linkTarget"
                }
              }
            }
          }
        }
      },
      "title": "SiteHeaderDefaultSection"
    },
    "StorySplitSection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "variant",
        "content"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "const": "story"
        },
        "variant": {
          "const": "split"
        },
        "content": {
          "title": "Brand Story",
          "type": "object",
          "required": [
            "title",
            "paragraphs",
            "media"
          ],
          "additionalProperties": false,
          "properties": {
            "eyebrow": {
              "type": "string",
              "minLength": 1,
              "description": "Small uppercase kicker above the heading."
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "description": "Section h2."
            },
            "paragraphs": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4,
              "items": {
                "type": "string",
                "minLength": 1
              },
              "description": "Narrative paragraphs in reading order."
            },
            "media": {
              "$ref": "#/$defs/media",
              "description": "Primary photograph."
            },
            "mediaSecondary": {
              "$ref": "#/$defs/media",
              "description": "Optional inset photograph."
            },
            "stats": {
              "type": "array",
              "minItems": 2,
              "maxItems": 4,
              "items": {
                "type": "object",
                "required": [
                  "value",
                  "label"
                ],
                "additionalProperties": false,
                "properties": {
                  "value": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Figure such as 24 or 100%."
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Short description of the figure."
                  }
                }
              }
            },
            "action": {
              "$ref": "#/$defs/siteAction",
              "description": "Optional follow-up link."
            }
          }
        }
      },
      "title": "StorySplitSection"
    },
    "TestimonialsGridSection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "variant",
        "content"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "const": "testimonials"
        },
        "variant": {
          "const": "grid"
        },
        "content": {
          "title": "Reviews Grid",
          "type": "object",
          "required": [
            "title",
            "items"
          ],
          "additionalProperties": false,
          "properties": {
            "eyebrow": {
              "type": "string",
              "minLength": 1,
              "description": "Small uppercase kicker above the heading."
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "description": "Section h2."
            },
            "description": {
              "type": "string",
              "minLength": 1,
              "description": "Short introduction under the heading."
            },
            "items": {
              "type": "array",
              "minItems": 3,
              "maxItems": 6,
              "items": {
                "type": "object",
                "required": [
                  "quote",
                  "name",
                  "location"
                ],
                "additionalProperties": false,
                "properties": {
                  "quote": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Reviewer quote in first person."
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Reviewer name."
                  },
                  "location": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Neighbourhood or city line, for example Boston, MA."
                  },
                  "rating": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 5,
                    "description": "Star rating out of five."
                  },
                  "media": {
                    "$ref": "#/$defs/media",
                    "description": "Optional reviewer portrait."
                  }
                }
              }
            }
          }
        }
      },
      "title": "TestimonialsGridSection"
    }
  }
}
