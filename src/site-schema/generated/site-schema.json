            "title",
            "description",
            "locations",
            "directionsLabel",
            "action"
          ]
        }
      },
      "title": "LocationsMapListSection"
    },
    "MenuCatalogSection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "variant",
        "content"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "const": "menu"
        },
        "variant": {
          "const": "catalog"
        },
        "content": {
          "title": "menu.catalog content",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "hero": {
              "type": "object",
              "additionalProperties": false,
