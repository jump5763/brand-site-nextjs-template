      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "href": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "footerContent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "brandName",
        "logoPath",
        "navigation"
      ],
      "properties": {
        "brandName": {
          "type": "string",
          "minLength": 1
        },
        "logoPath": {
          "type": "string",
          "minLength": 1
        },
        "tagline": {
          "type": "string",
          "minLength": 1
        },
        "copyright": {
          "type": "string",
          "minLength": 1
        },
        "navigation": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/footerLink"
          }
        },
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/footerLink"
          }
        },
        "legalLinks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/footerLink"
          }
        },
        "attribution": {
          "$ref": "#/$defs/footerLink"
        },
        "businessHours": {
          "$ref": "#/$defs/footerText"
        },
        "contact": {
          "$ref": "#/$defs/footerText"
        },
        "location": {
          "$ref": "#/$defs/footerText"
        }
      }
    },
    "catalogProduct": {
      "title": "CatalogProduct",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "priceCents": {
          "type": "integer",
          "minimum": 0
        },
        "calories": {
          "type": "integer",
          "minimum": 0
        },
        "diet": {
          "type": "array",
          "items": {
            "enum": [
              "Vegan",
              "Vegetarian",
              "Gluten-free",
              "High-protein"
            ]
          },
          "minItems": 0
        },
        "media": {
          "$ref": "#/$defs/media"
        },
        "badge": {
          "enum": [
            "New",
            "Limited",
            "Chef's pick",
            "Bestseller"
          ]
        }
      },
      "required": [
        "id",
        "name",
        "description",
        "category",
        "priceCents",
        "calories",
        "diet",
        "media"
      ]
    },
    "storeLocation": {
      "title": "StoreLocation",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "street": {
          "type": "string",
          "minLength": 1
        },
        "city": {
          "type": "string",
          "minLength": 1
        },
        "phone": {
          "type": "string",
          "minLength": 1
        },
        "phoneHref": {
          "type": "string",
          "minLength": 1
        },
        "hours": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "day": {
                "type": "string",
                "minLength": 1
              },
              "time": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "day",
              "time"
            ]
          },
          "minItems": 1
        }
      },
      "required": [
        "id",
        "name",
        "street",
        "city",
        "phone",
        "phoneHref",
        "hours"
      ]
    },
    "customerReview": {
      "title": "CustomerReview",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "quote": {
          "type": "string",
          "minLength": 1
        },
        "author": {
          "type": "string",
          "minLength": 1
        },
        "location": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "quote",
        "author",
        "location",
        "source"
      ]
    },
    "siteAction": {
      "title": "SiteAction",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "$ref": "#/$defs/linkTarget"
        }
      },
      "required": [
        "label",
        "target"
      ]
    },
    "iconLabel": {
      "title": "IconLabel",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "icon": {
          "enum": [
            "store",
            "leaf",
            "clock",
            "sprout",
            "bike"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "icon",
        "label"
      ]
    },
