{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codeforma.local/site-schema/generated",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "siteId",
    "siteUrl",
    "theme",
    "layout",
    "pages"
  ],
  "properties": {
    "siteId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"
    },
    "siteUrl": {
      "type": "string",
      "pattern": "^https?://[^\\s]+$",
      "format": "uri"
    },
    "theme": {
      "$ref": "#/$defs/theme"
    },
    "layout": {
      "$ref": "#/$defs/layout"
    },
    "pages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/page"
      }
    }
  },
  "$defs": {
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fonts",
        "colors"
      ],
      "properties": {
        "fonts": {
          "type": "object",
          "required": [
            "heading",
            "typography"
          ],
          "additionalProperties": false,
          "properties": {
            "heading": {
              "type": "string"
            },
            "typography": {
              "type": "string"
            }
          }
        },
        "colors": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "background",
            "primary50",
            "primary500",
            "primary900",
            "secondary50",
            "secondary500",
            "secondary900",
            "black100",
            "black900",
            "white"
          ],
          "patternProperties": {
            "^(background|primary(50|100|200|300|400|500|600|700|800|900)|secondary(50|100|200|300|400|500|600|700|800|900)|black(100|200|300|400|500|600|700|800|900)|white)$": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            }
          }
        }
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "metadata",
        "sections"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "path": {
          "type": "string",
          "pattern": "^/"
        },
        "metadata": {
          "$ref": "#/$defs/metadata"
        },
        "sections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/section"
          }
        }
      },
      "title": "SitePage"
    },
    "section": {
      "title": "SiteSection",
      "oneOf": [
        {
          "$ref": "#/$defs/CtaStoryLinksSection"
        },
        {
          "$ref": "#/$defs/FaqDefaultSection"
        },
        {
          "$ref": "#/$defs/FeaturesDeviceShowcaseSection"
        },
        {
          "$ref": "#/$defs/FeaturesIconGridSection"
        },
        {
          "$ref": "#/$defs/FeaturesMediaGridSection"
        },
        {
          "$ref": "#/$defs/FeaturesStoryDisclosuresSection"
        },
        {
          "$ref": "#/$defs/HeroDefaultSection"
        },
        {
          "$ref": "#/$defs/HeroIntroSection"
        },
        {
          "$ref": "#/$defs/LocationsFeaturedSingleSection"
        },
        {
          "$ref": "#/$defs/LocationsMapListSection"
        },
        {
          "$ref": "#/$defs/MenuCatalogSection"
        },
        {
          "$ref": "#/$defs/ProductsCarouselSection"
        },
        {
          "$ref": "#/$defs/ReviewsCarouselSection"
        },
        {
          "$ref": "#/$defs/StorySequenceSection"
        },
        {
          "$ref": "#/$defs/StorySplitSection"
        }
      ]
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonicalPath",
        "title",
        "description"
      ],
      "properties": {
        "canonicalPath": {
          "type": "string",
          "pattern": "^/"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "robots": {
          "type": "object",
          "required": [
            "index",
            "follow"
          ],
          "properties": {
            "index": {
              "type": "boolean"
            },
            "follow": {
              "type": "boolean"
            }
          }
        },
        "openGraph": {
          "type": "object"
        },
        "structuredData": {
          "type": [
            "object",
            "array"
          ]
        }
      }
    },
    "media": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "path",
        "alt",
        "width",
        "height"
      ],
      "properties": {
        "kind": {
          "const": "image"
        },
        "path": {
          "type": "string",
          "pattern": "^(\\/media\\/|https:\\/\\/)"
        },
        "alt": {
          "type": "string"
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "linkTarget": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "pageId"
          ],
          "properties": {
            "kind": {
              "const": "page"
            },
            "pageId": {
              "type": "string"
            },
            "fragment": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "href"
          ],
          "properties": {
            "kind": {
              "const": "external"
            },
            "href": {
              "type": "string",
              "pattern": "^https?://"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "header",
        "footer"
      ],
      "properties": {
        "header": {
          "$ref": "#/$defs/header"
        },
        "footer": {
          "$ref": "#/$defs/footer"
        }
      }
    },
    "header": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "variant",
        "content"
      ],
      "properties": {
        "variant": {
          "type": "string",
          "minLength": 1
        },
        "content": {
          "$ref": "#/$defs/headerContent"
        }
      }
    },
    "headerContent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "brandName",
        "logoPath",
        "navigation"
      ],
      "properties": {
        "brandName": {
          "type": "string",
          "minLength": 1
        },
        "hasOrdering": {
          "type": "boolean"
        },
        "logoPath": {
          "type": "string",
          "minLength": 1
        },
        "navigation": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "label",
              "target"
            ],
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1
              },
              "target": {
                "$ref": "#/$defs/linkTarget"
              }
            }
          }
        }
      }
    },
    "footer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "variant",
        "content"
      ],
      "properties": {
        "variant": {
          "type": "string",
          "minLength": 1
        },
        "content": {
          "$ref": "#/$defs/footerContent"
        }
      }
    },
    "footerLink": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "href"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "href": {
          "type": "string",
          "minLength": 1
        },
        "external": {
          "type": "boolean"
        }
      }
    },
    "footerText": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "text"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "href": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "footerContent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "brandName",
        "logoPath",
        "navigation"
      ],
      "properties": {
        "brandName": {
          "type": "string",
          "minLength": 1
        },
        "logoPath": {
          "type": "string",
          "minLength": 1
        },
        "tagline": {
          "type": "string",
          "minLength": 1
        },
        "copyright": {
          "type": "string",
          "minLength": 1
        },
        "navigation": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/footerLink"
          }
        },
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/footerLink"
          }
        },
        "legalLinks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/footerLink"
          }
        },
        "attribution": {
          "$ref": "#/$defs/footerLink"
        },
        "businessHours": {
          "$ref": "#/$defs/footerText"
        },
        "contact": {
          "$ref": "#/$defs/footerText"
        },
        "location": {
          "$ref": "#/$defs/footerText"
        }
      }
    },
    "CtaStoryLinksSection": {
      "title": "CtaStoryLinksSection",
      "type": "object",
      "required": [
        "id",
        "type",
        "variant",
        "content"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "const": "cta"
        },
        "variant": {
          "const": "story-links"
        },
        "content": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "title",
            "description",
            "actions"
          ],
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1
            },
            "description": {
              "type": "string",
              "minLength": 1
            },
            "actions": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "object",
                "required": [
                  "label",
                  "href"
                ],
                "additionalProperties": false,
                "properties": {
                  "label": {
                    "type": "string",
                    "minLength": 1
                  },
                  "href": {
                    "type": "string",
                    "pattern": "^/(?!/)"
                  }
                }
              }
            }
          }
        }
      }
    },
    "FaqDefaultSection": {
      "title": "FaqDefaultSection",
      "type": "object",
      "required": [
        "id",
        "type",
        "variant",
        "content"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "const": "faq"
        },
        "variant": {
          "const": "default"
        },
        "content": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "title",
            "description",
            "items"
          ],
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1
            },
            "description": {
              "type": "string",
              "minLength": 1
            },
            "items": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/FaqDefaultSection/$defs/item"
              }
            },
            "defaultExpandedIds": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "action": {
              "$ref": "#/$defs/FaqDefaultSection/$defs/action"
            }
          }
        }
      },
      "$defs": {
        "item": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "question",
            "answer"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "question": {
              "type": "string",
              "minLength": 1
            },
            "answer": {
              "type": "string",
              "minLength": 1
            },
            "dateCreated": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            }
          }
        },
        "action": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "label",
            "target"
          ],
          "properties": {
            "label": {
              "type": "string",
              "minLength": 1
            },
            "target": {
              "type": "object"
            }
          }
        }
      }
    },
    "FeaturesDeviceShowcaseSection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "variant",
        "content"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "const": "features"
        },
        "variant": {
          "const": "device-showcase"
        },
        "content": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "title",
            "description",
            "media",
            "items"
          ],
          "properties": {
            "title": {
              "type": "string"
            },
            "description": {
              "type": "string"
            },
            "media": {
              "type": "object"
            },
            "items": {
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          }
        }
      },
      "title": "FeaturesDeviceShowcaseSection"
    },
    "FeaturesIconGridSection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "variant",
        "content"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "const": "features"
        },
        "variant": {
          "const": "icon-grid"
        },
        "content": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "title",
            "description",
            "items"
          ],
          "properties": {
            "title": {
              "type": "string"
            },
            "description": {
              "type": "string"
            },
            "items": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "title",
                  "description",
                  "icon"
                ],
                "additionalProperties": true
              }
            }
          }
        }
      },
      "title": "FeaturesIconGridSection"
    },
    "FeaturesMediaGridSection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "variant",
        "content"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "const": "features"
        },
        "variant": {
          "const": "media-grid"
        },
        "content": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "title",
            "description",
            "items"
          ],
          "properties": {
            "title": {
              "type": "string"
            },
            "description": {
              "type": "string"
            },
            "items": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "title",
                  "description",
                  "media"
                ],
                "additionalProperties": true
              }
            }
          }
        }
      },
      "title": "FeaturesMediaGridSection"
    },
    "FeaturesStoryDisclosuresSection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "variant",
        "content"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "const": "features"
        },
        "variant": {
          "const": "story-disclosures"
        },
        "content": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "items"
          ],
          "properties": {
            "items": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "title",
                  "description",
                  "media"
                ],
                "additionalProperties": true
              }
            }
          }
        }
      },
      "title": "FeaturesStoryDisclosuresSection"
    },
    "HeroDefaultSection": {
      "title": "HeroDefaultSection",
      "type": "object",
      "required": [
        "id",
        "type",
        "variant",
        "content"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "const": "hero"
        },
        "variant": {
          "const": "default"
        },
        "content": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "title",
            "description",
            "media"
          ],
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1
            },
            "description": {
              "type": "string",
              "minLength": 1
            },
            "textColor": {
              "type": "string",
              "minLength": 1
            },
            "media": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/HeroDefaultSection/$defs/image"
              }
            },
            "primaryAction": {
              "$ref": "#/$defs/HeroDefaultSection/$defs/action"
            },
            "secondaryAction": {
              "$ref": "#/$defs/HeroDefaultSection/$defs/action"
            },
            "tertiaryAction": {
              "$ref": "#/$defs/HeroDefaultSection/$defs/action"
            }
          }
        }
      },
      "$defs": {
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "path",
            "alt",
            "width",
            "height"
          ],
          "properties": {
            "kind": {
              "const": "image"
            },
            "path": {
              "type": "string",
              "minLength": 1
            },
            "alt": {
              "type": "string"
            },
            "width": {
              "type": "integer",
              "minimum": 1
            },
            "height": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "action": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "label"
          ],
          "properties": {
            "label": {
              "type": "string",
              "minLength": 1
            },
            "href": {
              "type": "string",
              "minLength": 1
            },
            "target": {
              "type": "object"
            },
            "newTab": {
              "type": "boolean"
            }
          },
          "anyOf": [
            {
              "required": [
                "href"
              ]
            },
            {
              "required": [
                "target"
              ]
            }
          ]
        }
      }
    },
    "HeroIntroSection": {
      "title": "HeroIntroSection",
      "type": "object",
      "required": [
        "id",
        "type",
        "variant",
        "content"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "const": "hero"
        },
        "variant": {
          "const": "intro"
        },
        "content": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "title",
            "description",
            "media"
          ],
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1
            },
            "description": {
              "type": "string",
              "minLength": 1
            },
            "media": {
              "oneOf": [
                {
                  "$ref": "#/$defs/HeroIntroSection/$defs/image"
                },
                {
                  "$ref": "#/$defs/HeroIntroSection/$defs/googleMap"
                }
              ]
            }
          }
        }
      },
      "$defs": {
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "path",
            "alt",
            "width",
            "height"
          ],
          "properties": {
            "kind": {
              "const": "image"
            },
            "path": {
              "type": "string",
              "minLength": 1
            },
            "alt": {
              "type": "string"
            },
            "width": {
              "type": "integer",
              "minimum": 1
            },
            "height": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "googleMap": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "placeId",
            "accessibleTitle"
          ],
          "properties": {
            "kind": {
              "const": "google-map"
            },
            "placeId": {
              "type": "string",
              "minLength": 1
            },
            "accessibleTitle": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "LocationsFeaturedSingleSection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "variant",
        "content"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "const": "locations"
        },
        "variant": {
          "const": "featured-single"
        },
        "content": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "title",
            "description",
            "location",
            "services",
            "storefront",
            "actions"
          ],
          "properties": {
            "title": {
              "type": "string"
            },
            "description": {
              "type": "string"
            },
            "location": {
              "type": "object"
            },
            "services": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "storefront": {
              "type": "object"
            },
            "actions": {
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          }
        }
      },
      "title": "LocationsFeaturedSingleSection"
    },
    "LocationsMapListSection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "variant",
        "content"
      ],
      "properties": {
        "id": {
