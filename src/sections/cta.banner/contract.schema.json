{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codeforma.local/sections/cta.banner",
  "title": "cta.banner content",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "eyebrow": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "action": {
      "$ref": "https://codeforma.local/site-schema/core#/$defs/siteAction"
    },
    "perks": {
      "type": "array",
      "items": {
        "$ref": "https://codeforma.local/site-schema/core#/$defs/iconLabel"
      },
      "minItems": 1
    },
    "monogram": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "eyebrow",
    "title",
    "description",
    "action",
    "perks",
    "monogram"
  ]
}
