{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codeforma.local/sections/testimonials.grid",
  "title": "Reviews Grid",
  "type": "object",
  "required": ["title", "items"],
  "additionalProperties": false,
  "properties": {
    "eyebrow": { "type": "string", "minLength": 1, "description": "Small uppercase kicker above the heading." },
    "title": { "type": "string", "minLength": 1, "description": "Section h2." },
    "description": { "type": "string", "minLength": 1, "description": "Short introduction under the heading." },
    "items": {
      "type": "array",
      "minItems": 3,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": ["quote", "name", "location"],
        "additionalProperties": false,
        "properties": {
          "quote": { "type": "string", "minLength": 1, "description": "Reviewer quote in first person." },
          "name": { "type": "string", "minLength": 1, "description": "Reviewer name." },
          "location": { "type": "string", "minLength": 1, "description": "Neighbourhood or city line, for example Boston, MA." },
          "rating": { "type": "integer", "minimum": 1, "maximum": 5, "description": "Star rating out of five." },
          "media": { "$ref": "https://codeforma.local/site-schema/core#/$defs/media", "description": "Optional reviewer portrait." }
        }
      }
    }
  }
}
