{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codeforma.local/sections/locations.map-list",
  "title": "locations.map-list content",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "eyebrow": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "locations": {
      "type": "array",
      "items": {
        "$ref": "https://codeforma.local/site-schema/core#/$defs/storeLocation"
      },
      "minItems": 1
    },
    "directionsLabel": {
      "type": "string",
      "minLength": 1
    },
    "action": {
      "$ref": "https://codeforma.local/site-schema/core#/$defs/siteAction"
    }
  },
  "required": [
    "eyebrow",
    "title",
    "description",
    "locations",
    "directionsLabel",
    "action"
  ]
}
