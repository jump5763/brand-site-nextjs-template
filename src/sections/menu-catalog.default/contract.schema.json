{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codeforma.local/sections/menu-catalog.default",
  "title": "Menu Catalog",
  "type": "object",
  "required": ["title", "categories", "items"],
  "additionalProperties": false,
  "properties": {
    "eyebrow": { "type": "string", "minLength": 1, "description": "Small uppercase kicker above the section heading." },
    "title": { "type": "string", "minLength": 1, "description": "Stable section h2 above the category tabs." },
    "description": { "type": "string", "minLength": 1, "description": "Short introduction under the section heading." },
    "categories": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": ["name"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1, "description": "Tab label; every dish category must equal one of these names." },
          "description": { "type": "string", "minLength": 1, "description": "One line describing the category." }
        }
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "description", "price", "category", "media"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1, "description": "Card h4." },
          "description": { "type": "string", "minLength": 1, "description": "Short dish description." },
          "price": { "type": "string", "pattern": "^\\$[0-9]+\\.[0-9]{2}$", "description": "Display price such as $12.75." },
          "category": { "type": "string", "minLength": 1, "description": "Must equal one of the declared category names." },
          "tags": { "type": "array", "minItems": 1, "maxItems": 3, "items": { "type": "string", "minLength": 1 }, "description": "Dietary labels such as Vegan, Gluten-Free, High Protein, Spicy." },
          "metadata": { "type": "string", "minLength": 1, "description": "Short factual detail such as 420 cal or Serves 2." },
          "badge": { "type": "string", "minLength": 1, "description": "Optional short label such as New, Chef's pick or Limited." },
          "media": { "$ref": "https://codeforma.local/site-schema/core#/$defs/media" }
        }
      }
    }
  }
}
