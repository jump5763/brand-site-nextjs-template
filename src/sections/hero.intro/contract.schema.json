{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codeforma.local/keke/sections/hero.intro.schema.json",
  "title": "Hero Intro Section",
  "type": "object",
  "required": ["id", "type", "variant", "content"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "type": { "const": "hero" },
    "variant": { "const": "intro" },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "description", "media"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "media": {
          "oneOf": [
            { "$ref": "#/$defs/image" },
            { "$ref": "#/$defs/googleMap" }
          ]
        }
      }
    }
  },
  "$defs": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "alt", "width", "height"],
      "properties": {
        "kind": { "const": "image" },
        "path": { "type": "string", "minLength": 1 },
        "alt": { "type": "string" },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      }
    },
    "googleMap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "placeId", "accessibleTitle"],
      "properties": {
        "kind": { "const": "google-map" },
        "placeId": { "type": "string", "minLength": 1 },
        "accessibleTitle": { "type": "string", "minLength": 1 }
      }
    }
  }
}
