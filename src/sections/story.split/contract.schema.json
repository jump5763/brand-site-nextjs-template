{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codeforma.local/keke/sections/story.split.schema.json",
  "title": "Story Split Section",
  "type": "object",
  "required": ["id", "type", "variant", "content"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "type": { "const": "story" },
    "variant": { "const": "split" },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "description", "media"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "media": { "$ref": "#/$defs/image" },
        "action": { "$ref": "#/$defs/action" }
      }
    }
  },
  "$defs": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "alt", "width", "height"],
      "properties": {
        "kind": { "const": "image" },
        "path": { "type": "string", "minLength": 1 },
        "alt": { "type": "string" },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "target"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "target": { "type": "object" }
      }
    }
  }
}
