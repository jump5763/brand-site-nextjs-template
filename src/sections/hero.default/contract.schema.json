{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codeforma.local/keke/sections/hero.default.schema.json",
  "title": "Hero Default Section",
  "type": "object",
  "required": ["id", "type", "variant", "content"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "type": { "const": "hero" },
    "variant": { "const": "default" },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "description", "media"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "textColor": { "type": "string", "minLength": 1 },
        "media": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/image" }
        },
        "primaryAction": { "$ref": "#/$defs/action" },
        "secondaryAction": { "$ref": "#/$defs/action" },
        "tertiaryAction": { "$ref": "#/$defs/action" }
      }
    }
  },
  "$defs": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "alt", "width", "height"],
      "properties": {
        "kind": { "const": "image" },
        "path": { "type": "string", "minLength": 1 },
        "alt": { "type": "string" },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "href": { "type": "string", "minLength": 1 },
        "target": { "type": "object" },
        "newTab": { "type": "boolean" }
      },
      "anyOf": [{ "required": ["href"] }, { "required": ["target"] }]
    }
  }
}
