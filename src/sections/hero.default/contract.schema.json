{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codeforma.local/sections/hero.default",
  "title": "hero.default content",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "eyebrow": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "primaryAction": {
      "$ref": "https://codeforma.local/site-schema/core#/$defs/siteAction"
    },
    "secondaryAction": {
      "$ref": "https://codeforma.local/site-schema/core#/$defs/siteAction"
    },
    "benefits": {
      "type": "array",
      "items": {
        "$ref": "https://codeforma.local/site-schema/core#/$defs/iconLabel"
      },
      "minItems": 1
    },
    "media": {
      "type": "array",
      "items": {
        "$ref": "https://codeforma.local/site-schema/core#/$defs/media"
      },
      "minItems": 1
    },
    "carousel": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "caption": {
          "type": "string",
          "minLength": 1
        },
        "freshLabel": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "label",
        "caption",
        "freshLabel"
      ]
    }
  },
  "required": [
    "eyebrow",
    "title",
    "description",
    "primaryAction",
    "secondaryAction",
    "benefits",
    "media",
    "carousel"
  ]
}
