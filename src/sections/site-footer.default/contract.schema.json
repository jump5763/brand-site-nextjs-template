{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codeforma.local/sections/site-footer.default",
  "title": "Site Footer",
  "type": "object",
  "required": ["brandName", "tagline", "explore", "hours", "visit", "legalNote"],
  "additionalProperties": false,
  "properties": {
    "brandName": { "type": "string", "minLength": 1 },
    "tagline": { "type": "string", "minLength": 1 },
    "social": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/socialLink" }
    },
    "explore": { "$ref": "#/$defs/linkColumn" },
    "hours": { "$ref": "#/$defs/hoursColumn" },
    "visit": { "$ref": "#/$defs/visitColumn" },
    "backToTop": {
      "$ref": "https://codeforma.local/site-schema/core#/$defs/siteAction"
    },
    "legalNote": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "socialLink": {
      "type": "object",
      "required": ["label", "icon", "target"],
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "description": "Accessible name of the icon-only link."
        },
        "icon": {
          "enum": ["instagram", "facebook", "youtube"]
        },
        "target": { "$ref": "https://codeforma.local/site-schema/core#/$defs/linkTarget" }
      }
    },
    "linkColumn": {
      "type": "object",
      "required": ["title", "links"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "links": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/labeledTarget" }
        }
      }
    },
    "labeledTarget": {
      "type": "object",
      "required": ["label", "target"],
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "target": { "$ref": "https://codeforma.local/site-schema/core#/$defs/linkTarget" }
      }
    },
    "hoursColumn": {
      "type": "object",
      "required": ["title", "entries"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "entries": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/labelValue" }
        }
      }
    },
    "labelValue": {
      "type": "object",
      "required": ["label", "value"],
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "value": { "type": "string", "minLength": 1 }
      }
    },
    "visitColumn": {
      "type": "object",
      "required": ["title", "stores", "email"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "email": { "type": "string", "minLength": 1 },
        "stores": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/store" }
        }
      }
    },
    "store": {
      "type": "object",
      "required": ["name", "address"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "address": { "type": "string", "minLength": 1 },
        "phone": { "type": "string", "minLength": 1 }
      }
    }
  }
}
