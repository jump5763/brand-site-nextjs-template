{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codeforma.local/sections/reviews.carousel",
  "title": "reviews.carousel content",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "eyebrow": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "reviews": {
      "type": "array",
      "items": {
        "$ref": "https://codeforma.local/site-schema/core#/$defs/customerReview"
      },
      "minItems": 1
    }
  },
  "required": [
    "eyebrow",
    "title",
    "reviews"
  ]
}
