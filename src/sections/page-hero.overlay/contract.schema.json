{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codeforma.local/sections/page-hero.overlay",
  "title": "Full-Screen Hero",
  "type": "object",
  "required": ["headline", "media", "primaryAction"],
  "additionalProperties": false,
  "properties": {
    "eyebrow": {
      "type": "string",
      "minLength": 1,
      "description": "Small uppercase kicker above the headline."
    },
    "headline": {
      "type": "string",
      "minLength": 1,
      "description": "The page h1. One per page."
    },
    "subheadline": {
      "type": "string",
      "minLength": 1,
      "description": "Supporting sentence under the headline."
    },
    "media": {
      "$ref": "https://codeforma.local/site-schema/core#/$defs/media",
      "description": "Full-bleed background photograph."
    },
    "primaryAction": {
      "$ref": "https://codeforma.local/site-schema/core#/$defs/siteAction"
    },
    "secondaryAction": {
      "$ref": "https://codeforma.local/site-schema/core#/$defs/siteAction"
    },
    "highlights": {
      "type": "array",
      "minItems": 2,
      "maxItems": 4,
      "items": { "$ref": "#/$defs/highlight" }
    }
  },
  "$defs": {
    "highlight": {
      "type": "object",
      "required": ["value", "label"],
      "additionalProperties": false,
      "properties": {
        "value": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 }
      }
    }
  }
}
