{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codeforma.local/sections/site-header.default",
  "title": "Site Header",
  "type": "object",
  "required": ["brandName", "navigation", "action"],
  "additionalProperties": false,
  "properties": {
    "brandName": {
      "type": "string",
      "minLength": 1,
      "description": "Wordmark shown at the start of the bar."
    },
    "brandTagline": {
      "type": "string",
      "minLength": 1,
      "description": "Short line rendered under the wordmark on wider viewports."
    },
    "brandTarget": {
      "$ref": "https://codeforma.local/site-schema/core#/$defs/linkTarget",
      "description": "Destination of the wordmark link. Defaults to the site root."
    },
    "navigation": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/navigationItem" }
    },
    "action": {
      "$ref": "https://codeforma.local/site-schema/core#/$defs/siteAction",
      "description": "Primary call to action rendered as the brand button."
    }
  },
  "$defs": {
    "navigationItem": {
      "type": "object",
      "required": ["label", "target"],
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "target": { "$ref": "https://codeforma.local/site-schema/core#/$defs/linkTarget" }
      }
    }
  }
}
