{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codeforma.local/keke/sections/cta.story-links.schema.json",
  "title": "CTA Story Links Section",
  "type": "object",
  "required": ["id", "type", "variant", "content"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "type": { "const": "cta" },
    "variant": { "const": "story-links" },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "description", "actions"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "actions": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "object",
            "required": ["label", "href"],
            "additionalProperties": false,
            "properties": {
              "label": { "type": "string", "minLength": 1 },
              "href": { "type": "string", "pattern": "^/(?!/)" }
            }
          }
        }
      }
    }
  }
}
