{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codeforma.local/sections/page-hero.banner",
  "title": "Page Banner",
  "type": "object",
  "required": ["title", "media"],
  "additionalProperties": false,
  "properties": {
    "eyebrow": {
      "type": "string",
      "minLength": 1,
      "description": "Small uppercase kicker above the title."
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "description": "The page h1. One per page."
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "description": "Short introduction paragraph."
    },
    "media": {
      "$ref": "https://codeforma.local/site-schema/core#/$defs/media",
      "description": "Photograph displayed beside the introduction."
    },
    "meta": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": { "type": "string", "minLength": 1 },
      "description": "Short pills summarising the page content."
    }
  }
}
