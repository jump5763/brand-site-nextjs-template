{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codeforma.local/sections/features.icon-grid",
  "title": "features.icon-grid content",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "icon": {
            "enum": [
              "store",
              "leaf",
              "clock",
              "sprout",
              "bike"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "icon",
          "title",
          "text"
        ]
      },
      "minItems": 1
    }
  },
  "required": [
    "items"
  ]
}
