{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codeforma.local/sections/featured-dishes.carousel",
  "title": "Featured Dishes Carousel",
  "type": "object",
  "required": ["title", "items"],
  "additionalProperties": false,
  "properties": {
    "eyebrow": { "type": "string", "minLength": 1, "description": "Small uppercase kicker above the section heading." },
    "title": { "type": "string", "minLength": 1, "description": "Section h2." },
    "description": { "type": "string", "minLength": 1, "description": "Short introduction under the section heading." },
    "items": { "type": "array", "minItems": 3, "maxItems": 8, "items": { "$ref": "#/$defs/dish" } },
    "action": { "$ref": "https://codeforma.local/site-schema/core#/$defs/siteAction", "description": "Optional link to the complete menu." }
  },
  "$defs": {
    "dish": {
      "type": "object",
      "required": ["name", "description", "price", "media"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1, "description": "Card h3." },
        "description": { "type": "string", "minLength": 1, "description": "Short dish description." },
        "price": { "type": "string", "pattern": "^\\$[0-9]+\\.[0-9]{2}$", "description": "Display price such as $12.75." },
        "badge": { "type": "string", "minLength": 1, "description": "Optional short label such as New or Seasonal." },
        "media": { "$ref": "https://codeforma.local/site-schema/core#/$defs/media" },
        "action": { "$ref": "https://codeforma.local/site-schema/core#/$defs/siteAction" }
      }
    }
  }
}
